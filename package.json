{
  "name": "@flarelabs-net/workers-observability-utils",
  "version": "0.3.5",
  "description": "A collection of Utilities for Capturing Logs and Metrics from Cloudflare Workers",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./tail": {
      "types": "./dist/tail.d.ts",
      "import": "./dist/tail.js"
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "check:publint": "publint",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "lint:fix": "biome lint --fix",
    "release": "release-it"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "observability",
    "metrics",
    "logging"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.8",
    "@cloudflare/workers-types": "^4.20260521.1",
    "@types/node": "^22.15.19",
    "biome": "^0.3.3",
    "release-it": "^19.0.3",
    "publint": "^0.3.21",
    "rolldown": "^1.0.3",
    "rolldown-plugin-dts": "^0.25.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "flat": "^6.0.1",
    "ulid-workers": "^2.1.0"
  },
  "volta": {
    "node": "24.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}